# Copy to terraform.tfvars and fill in. (terraform.tfvars is gitignored.)
region           = "ap-south-1"
instance_type    = "t3.small"
domain_name      = "chat.example.com"
ssh_allowed_cidr = "203.0.113.10/32" # your public IP, /32
public_key_path  = "~/.ssh/id_ed25519.pub"
image_owner      = "your-github-username" # lowercase ghcr owner
image_tag        = "latest"
