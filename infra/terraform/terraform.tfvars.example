# Copy to terraform.tfvars and fill in. (terraform.tfvars is gitignored.)
project_name = "caas" # prefixes every AWS resource: caas-backend, caas-cdn, ...
region       = "us-east-2"

# GitHub repo (owner/name) allowed to assume the OIDC deploy role.
github_repo = "malikfahadsaeed/CaaS"
# Set false if the account already has a GitHub Actions OIDC provider.
create_github_oidc_provider = true

# Bedrock: verify the model id/availability and enable model access in the
# console first. From us-east-2, a US cross-region inference profile is typical.
bedrock_model_id   = "us.anthropic.claude-sonnet-4-20250514-v1:0"
bedrock_region     = "us-east-2"
bedrock_max_tokens = 512

# ECR tag the Lambda runs (CI updates code out-of-band afterwards).
lambda_image_tag = "latest"
