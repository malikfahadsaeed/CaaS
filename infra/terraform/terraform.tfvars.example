# Copy to terraform.tfvars and fill in. (terraform.tfvars is gitignored.)
project_name     = "fahad" # prefixes every AWS resource: fahad-vpc, fahad-app, ...
region           = "us-east-2"
instance_type    = "t3.small"
domain_name      = "fmchatbot.duckdns.org"
ssh_allowed_cidr = "REPLACE_WITH_YOUR_IP/32" # run `curl ifconfig.me`, then add /32
public_key_path  = "~/.ssh/id_ed25519.pub"   # run `ssh-keygen -t ed25519` if you don't have one
image_owner      = "malikfahadsaeed"         # ghcr owner = your GitHub account (lowercase)
image_tag        = "latest"
