#!/bin/bash
set -euo pipefail

# --- Install Docker + Compose plugin (Amazon Linux 2023) ---
dnf update -y
dnf install -y docker
systemctl enable --now docker

DOCKER_CLI_PLUGINS=/usr/local/lib/docker/cli-plugins
mkdir -p "$DOCKER_CLI_PLUGINS"
curl -SL https://github.com/docker/compose/releases/latest/download/docker-compose-linux-x86_64 \
  -o "$DOCKER_CLI_PLUGINS/docker-compose"
chmod +x "$DOCKER_CLI_PLUGINS/docker-compose"

# --- Deploy the application stack ---
install -d -m 0755 /opt/caas

# Compose file and Caddyfile are injected by Terraform (base64 avoids escaping).
echo "${compose_b64}" | base64 -d > /opt/caas/docker-compose.yml
echo "${caddyfile_b64}" | base64 -d > /opt/caas/Caddyfile

# Environment consumed by docker compose variable substitution.
cat > /opt/caas/.env <<EOF
DOMAIN=${domain}
IMAGE_OWNER=${image_owner}
IMAGE_TAG=${image_tag}
EOF

cd /opt/caas
docker compose pull
docker compose up -d
