# Backend configuration (copy to .env and adjust as needed)
APP_NAME=CaaS Backend
ENVIRONMENT=development
LOG_LEVEL=INFO
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000

# Amazon Bedrock. BEDROCK_MODEL_ID should be a foundation model id or a
# cross-region inference profile id available in BEDROCK_REGION. Enable model
# access in the AWS console first. Credentials come from the environment / the
# Lambda execution role (no keys committed).
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-20250514-v1:0
BEDROCK_REGION=us-east-2
BEDROCK_MAX_TOKENS=512
# SYSTEM_PROMPT=You are a helpful, concise AI assistant for a chat application.
